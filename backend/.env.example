# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://reachinbox:reachinbox_password@localhost:5432/reachinbox_scheduler?schema=public
# For zero-dependency SQLite alternative (uncomment if testing without Postgres):
# DATABASE_URL=file:./dev.db

# Redis Configuration (BullMQ & Rate Limiter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Scheduler & Worker Concurrency
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_SECONDS=2
DEFAULT_HOURLY_LIMIT=200

# Ethereal Email (Leave empty to auto-generate ephemeral credentials on startup)
ETHEREAL_USER=
ETHEREAL_PASS=

# Elasticsearch (Full-text email search)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Slack OAuth & Notifications
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/oauth/callback

# Google OAuth
GOOGLE_CLIENT_ID=
